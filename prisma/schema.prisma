generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  costPrice   Float?
  imageUrl    String?
  category    String
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  images     ProductImage[]
  variants   ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String?
  size      String?
  stock     Int      @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Reseller {
  id              String   @id @default(cuid())
  name            String
  email           String?  @unique
  phone           String?
  city            String?
  code            String   @unique
  passwordHash    String?
  discountPercent Float    @default(10)
  active          Boolean  @default(true)
  discountActive  Boolean  @default(true)
  createdAt       DateTime @default(now())

  orders Order[]
}

model SiteSettings {
  id                  String   @id @default("singleton")
  storeName           String   @default("Mi Catálogo")
  primaryColor        String   @default("#db2777")
  bannerTitle         String   @default("Moda para vos y para revender")
  bannerSubtitle      String   @default("Elegí tus prendas favoritas. ¿Sos revendedora? Ingresá tu código en el checkout y obtené tu descuento.")
  bannerImageUrl      String?
  whatsappNumber      String   @default("")
  targetMarginPercent Float?
  transferAlias       String   @default("REINASXL.NARANJA")
  transferHolderName  String   @default("Nahir Borda")
  transferPhone       String   @default("2302-667574")
  updatedAt           DateTime @updatedAt
}

model RewardTier {
  id           String   @id @default(cuid())
  title        String
  description  String?
  targetAmount Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id              String    @id @default(cuid())
  customerName    String
  customerPhone   String
  customerAddress String
  notes           String?
  subtotal        Float
  discountAmount  Float     @default(0)
  total           Float
  resellerId      String?
  reseller        Reseller? @relation(fields: [resellerId], references: [id])
  status          String    @default("PENDIENTE")
  createdAt       DateTime  @default(now())

  paymentMethod    String   @default("WHATSAPP") // WHATSAPP | MERCADOPAGO
  paymentStatus    String   @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO
  mpPreferenceId   String?
  mpPaymentId      String?

  items OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  variantId    String?
  variantColor String?
  variantSize  String?
  price        Float
  quantity     Int
}
